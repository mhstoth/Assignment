		"@types/node": "^25.0.3",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.36.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@types/leaflet": "^1.9.21",
