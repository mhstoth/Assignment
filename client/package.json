		"format": "prettier --write .",
		"start": "node build"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.8",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
